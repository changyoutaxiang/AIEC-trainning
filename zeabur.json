{
  "name": "aiec-learning-system",
  "services": [
    {
      "name": "web",
      "type": "nodejs",
      "buildCommand": "npm install",
      "startCommand": "npm start",
      "port": 3000,
      "env": {
        "NODE_ENV": "production",
        "DATABASE_PATH": "/data/database/aiec_users.db",
        "UPLOADS_PATH": "/data/uploads"
      },
      "volumes": [
        {
          "name": "persistent-data",
          "mountPath": "/data"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "persistent-data",
      "size": "2GB"
    }
  ]
}